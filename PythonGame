                    target_enemy.hp = max(0, target_enemy.hp - single_dmg)
                    print(f"{target_enemy.name} takes {single_dmg} damage from the skill! (HP: {target_enemy.hp})")
                    
                    # CHECK DEATH FROM SINGLE TARGET SKILL
                    if target_enemy.hp <= 0:
                        print(f"{target_enemy.name} is killed!")
                    time.sleep(1)

                # Heal implementation
                elif isinstance(result, tuple) and result[0] == "heal":
                    heal_amount = result[1]
