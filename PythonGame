    def print_boxed_message(title, lines, border_char="-", corner_char="+"):
        try:
            terminal_width = shutil.get_terminal_size((80, 20)).columns
        except Exception:
            terminal_width = 80
        
        max_box_width = min(76, terminal_width - 4)
    
        # Process text wrapping
        processed_lines = []
        for line in lines:
            if line == "---":
                processed_lines.append("---")
                continue
            if len(line) <= max_box_width:
                processed_lines.append(line)
            else:
                words = line.split(' ')
                current_line = ""
                for word in words:
                    if len(current_line) + len(word) + 1 <= max_box_width:
                        current_line += (word + " ")
                    else:
                        processed_lines.append(current_line.rstrip())
                        current_line = word + " "
                if current_line:
                    processed_lines.append(current_line.rstrip())

        # Calculate widths
        content_width = max(len(line) for line in processed_lines if line != "---")
        content_width = max(content_width, len(title))
        box_width = content_width + 4

        # Print Top Header
        title_str = f" {title} " if title else ""
        remaining_space = box_width - len(title_str) - 2
        left_padding = remaining_space // 2
        right_padding = remaining_space - left_padding
        print(corner_char + (border_char * left_padding) + title_str + (border_char * right_padding) + corner_char)
        print(f"|{' ' * (box_width - 2)}|")
    
        # Print Body Rows
        for line in processed_lines:
            if line == "---":
                # Prints a clean divider inside the box context
                print(f"|{border_char * (box_width - 2)}|")
            else:
                padding_needed = box_width - len(line) - 4
                print(f"| {line}{' ' * padding_needed} |")
        
        print(f"|{' ' * (box_width - 2)}|")
        print(corner_char + (border_char * (box_width - 2)) + corner_char)

