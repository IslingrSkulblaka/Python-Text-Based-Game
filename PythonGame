class Combat:        
    def __init__(self, player, enemies):
        self.player = player
        self.enemies = enemies
        self.combatants = [player] + enemies

        print("\nRolling Initiative...")
        rolls = {}
        for c in self.combatants:
            roll = random.randint(1, 20)
            rolls[c] = roll
            print(f" - {c.name} rolled a {roll}!")
            
        self.initiative_order = sorted(self.combatants, key=lambda c: rolls[c], reverse=True)
        self.current_turn_index = 0
        time.sleep(1)

    def next_turn(self):
        if self.current_turn_index >= len(self.initiative_order):
            self.current_turn_index = 0
        current_combatant = self.initiative_order[self.current_turn_index]
        self.current_turn_index += 1
        return current_combatant

    def start_battle_loop(self):
        print("\nCOMBAT HAS BEGUN!")
        
        while True:
            # Check if all enemies are defeated
            live_enemies = [e for e in self.enemies if e.hp > 0]
            if not live_enemies:
                time.sleep(1)
                print("\nVictory! You defeated all the enemies!")
                time.sleep(1)
                return "victory"
                
            # Check if player is defeated
            if self.player.hp <= 0:
                time.sleep(1)
                print("\nYou have fallen in battle... Game Over.")
                time.sleep(1)
                return "game_over"

            # Get the combatant whose turn it is
            current = self.next_turn()
        
            # If it's a dead enemy, skip their turn
            if hasattr(current, 'hp') and current.hp <= 0:
                continue

            # If enemy has status, activate the status effect
            if hasattr(current, 'statuses'):
                # Check for Frozen status
                if current.statuses.get("Frozen", 0) > 0:
                    print(f"\n{current.name} is frozen solid and skips their turn!")
                    current.statuses["Frozen"] -= 1  # Reduce duration by 1 turn
                    
                    # Clean up the status if it expires
                    if current.statuses["Frozen"] == 0:
                        del current.statuses["Frozen"]
                        print(f"\n{current.name} thawed out!")
                        
                    time.sleep(1)
                    continue  # Skip to the next combatant's turn
                #Check for Kindle status
                elif current.statuses.get("Kindle", 0) > 0:
                    burn_damage = 10
                    current.hp -= burn_damage
                    print(f"\n{current.name} takes {burn_damage} burn damage! (HP: {max(0, current.hp)})")

                    # If the burn killed them, immediately skip their action
                    if current.hp <= 0:
                        print(f"{current.name} was defeated by Kindle's burn!")
                        continue
                    
                    current.statuses["Kindle"] += 1 # Increase duration so that Kindle lasts as long as enemy is alive
                    if current.statuses["Kindle"] == 0:
                        del current.statuses["Kindle"]
                        print(f"\n{current.name}'s fire went out!")
                    
                    time.sleep(1)

                elif current.statuses.get("Shock", 0) > 0:
                    shocked_damage = 5
                    current.hp -= shocked_damage
                    print(f"\n{current.name} takes {shocked_damage} electric damage! (HP: {max(0, current.hp)})")

                    # Immediate death check. If the voltage kills them, stop here
                    if current.hp <= 0:
                        print(f"{current.name} dies from the high voltage!")
                        continue 
                 
                    current.statuses["Shock"] -= 1

                    if current.statuses["Shock"] <= 0:
                        if "Shock" in current.statuses:
                            del current.statuses["Shock"]
                        print(f"{current.name} regained control of their limbs!")
                    
                    time.sleep(1)
                    continue
                elif current.statuses.get("Stun", 0) > 0:
                    print(f"\n{current.name} is stunned for one turn!")
                    current.statuses["Stun"] -= 1  # Reduce duration by 1 turn
                    
                    # Clean up the status if it expires
                    if current.statuses["Stun"] == 0:
                        del current.statuses["Stun"]
                        print(f"\n{current.name} recovers their wits!")
                        
                    time.sleep(1)
                    continue  # Skip to the next combatant's turn

            if hasattr(current, 'buffs'):
                if current.buffs.get("Inspiration", 0) > 0:
                    current.buffs["Inspiration"] -= 1
                    self.player.mana += 10

                    if current.buffs["Inspiration"] == 0:
                        self.player.mana -= 20
                        print(f"\nInspiration has worn off!")

                if current.buffs.get("Meditation", 0) > 0:
                    current.buffs["Meditation"] -= 1

                    is_self_player = (current == self.player)

                    if is_self_player:
                        self.player.mana += 10

                # Wild shape buff
                if "Wild Shape" in current.buffs:
                    # Get which form the player is currently using
                    current_form = current.active_form

                    if current_form:
                        # Apply bonuses dynamically based on the form string
                        if current_form.lower() == "bear":
                            bonus_hp = 20
                            current.hp += bonus_hp

                        elif current_form.lower() == "hawk":
                            bonus_chance = 0.3
                            if hasattr(current, 'crit_chance'):
                                current.crit_chance += bonus_chance

                        elif current_form.lower() == "jaguar":
                            bonus_attack = 10
                            if hasattr(current, 'attack'):
                                current.attack += bonus_attack

                    # Ticks down the buff timer by 1 turn
                    current.buffs["Wild Shape"] -= 1
                    
                    # Only removes stats if the timer hits 0 or less
                    if current.buffs["Wild Shape"] <= 0:
                        if current_form:
                            if current_form.lower() == "bear":
                                self.player.hp -= 40

                            elif current_form.lower() == "hawk":
                                if hasattr(current, 'crit_chance'):
                                    self.player.crit_chance -= 0.6

                            elif current_form.lower() == "jaguar":
                                if hasattr(current, 'attack'):
                                    self.player.attack -= 20
                        
                        # Cleans up the dictionary and resets the form
                        del current.buffs["Wild Shape"]
                        print(f"\n{current.name}'s Wild Shape has expired! Shifting back to normal form.")
                        time.sleep(1)
                        current.active_form = None

            # Player Turn
            if isinstance(current, Player):
                # Pass the enemies list to the player's choice tracker
                result = current.take_turn(self.enemies)
                if result == "flee":
                    return "flee"       
                
                # UNIVERSAL AOE IMPLEMENTATION
                # If an action returns e.g. ("aoe", 10), apply it to all living targets here
                elif isinstance(result, tuple) and result[0] == "aoe":
                    action_type = result[0]
                    aoe_dmg = result[1] # Extract the numeric damage value from the tuple
                    status_name = result[2] if len(result) > 2 else None
                    status_dur = result[3] if len(result) > 3 else 0
                    for enemy in live_enemies:
                        enemy.hp = max(0, enemy.hp - aoe_dmg)
                        print()
                        print(f"{enemy.name} takes {aoe_dmg} AoE damage! (HP: {enemy.hp})")

                        # Inflict the status on every live enemy
                        if status_name and hasattr(enemy, 'statuses'):
                            enemy.statuses[status_name] = status_dur
                            print(f"{enemy.name} is afflicted with {status_name} for {status_dur} turns!")

                        # CHECK DEATH FROM AOE ACTIONS
                        if enemy.hp <= 0:
                            print(f"{enemy.name} is killed!")
                    time.sleep(1)
                
                elif isinstance(result, tuple) and result[0] == "single":
                    single_dmg = result[1]
                    target_enemy = result[2]
                    
