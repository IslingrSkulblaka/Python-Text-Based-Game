                                reflected_damage = current.attack  # Full reflection for perfect
                                print("\nPerfect Parry Bonus: Full damage reflected!")
                            else:
                                reflected_damage = int(current.attack / 2)  # Half reflection for normal
                                current.hp -= reflected_damage
                                print("\nNormal Parry: Half damage reflected!")
                                print(f"\n{self.player.name} takes {reflected_damage} damage!")
                                
                            self.player.reflection_active = True
        
                            print(f"\nReflection Active! {self.player.name} reflects {reflected_damage} damage back to {current.name}!")
                            print(f"{current.name} now has {max(0, current.hp)} HP.")
                            time.sleep(1)
        
                            # Check if the reflected damage killed the enemy
                            if current.hp <= 0:
                                print(f"\n{current.name} was killed by their own attack!")
