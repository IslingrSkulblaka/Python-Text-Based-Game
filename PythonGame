class Combatant:
    def __init__(self, name: str, hp: int, attack: int, mana: int, crit_chance: float = 0.10, crit_damage: float = 1.5):
        self.name = name
        self.hp = hp
        self.attack = attack
        self.mana = mana
        self.crit_chance = crit_chance
        self.crit_damage = crit_damage
        self.statuses = {}

    #Crit calculation method
    def calculate_damage(self, base_damage: int) -> tuple[int, bool]:
        #Calculates final damage and returns (damage_amount, is_crit).
        is_crit = random.random() < self.crit_chance
        if is_crit:
            final_damage = int(base_damage * self.crit_damage)
            return final_damage, True
        return base_damage, False

class Player(Combatant):
    def __init__(self, name: str, hp: int, attack: int, mana: int, crit_chance: float = 0.10, crit_damage: float = 1.5):
        self.name = name
        self.hp = hp
        self.max_hp = hp
        self.mana = mana
        self.max_mana = mana
        self.attack = attack
        self.crit_chance = crit_chance
        self.crit_damage = crit_damage
        self.inventory = [
            {"name": "Healing Potion", "type": "hp", "value": 30, "qty": 3},
            {"name": "Mana Potion", "type": "mana", "value": 20, "qty": 2}
        ]
        self.abilities = {}
        self.statuses = {}
        self.buffs = {}
        self.quests = {}
        self.gold = 20  # Starting gold currency
        self.current_room = 'Town Square'

    def take_turn(self, enemies):
        # Displays available abilities and processes user choice.
            
        # Filter to make sure it only target enemies that have HP left
        live_enemies = [e for e in enemies if e.hp > 0]
        if not live_enemies:
            return "victory"
            
        print(f"\n--- It is {self.name}'s turn! ---")
        print(f"HP: {self.hp}/{self.max_hp} | Mana: {self.mana}/{self.max_mana}")

        while True:

            # Main Action Menu
            print("\nWhat would you like to do?")
            print("[1] Basic Attack")
            print("[2] Use Ability")
            print("[3] Use Potion")
            print("[4] Flee")
            
            try:
                action_choice = int(input("Select (1-4): "))
            
                #Option 1: Basic attack
                if action_choice == 1:
                    target = self._select_target(live_enemies)
                    # Simple attack logic; handles crit based on stats
                    damage = self.attack
                    import random
                    if random.random() < self.crit_chance:
                        damage = int(damage * self.crit_damage)
                        print(f"\nCRITICAL HIT!")
                    
                    target.hp = max(0, target.hp - damage)
                    print(f"{self.name} attacks {target.name} for {damage} damage!")
                    if damage > target.hp:
                        print(f"\n{target.name} is killed!")
                    return "continue"

                #Option 2: Use abilities
                elif action_choice == 2:
                    if not self.abilities:
                        print("You don't know any abilities yet!")
                        continue
                        
                    ability_list = list(self.abilities.keys())
                    print("\n--- Choose an ability ---")
                    for idx, name in enumerate(ability_list, start=1):
                        print(f"[{idx}] {name} (Costs {self.abilities[name]['cost']} Mana)")
                    print(f"[{len(ability_list) + 1}] Back")
                    
                    sub_choice = int(input(f"Select (1-{len(ability_list) + 1}): "))
                    if sub_choice == len(ability_list) + 1:
                        continue # Go back to main loop
                        
                    if 1 <= sub_choice <= len(ability_list):
                        chosen_ability_name = ability_list[sub_choice - 1]
                        ability_data = self.abilities[chosen_ability_name]
                        
                        if self.mana >= ability_data["cost"]:
                            self.mana -= ability_data["cost"]

                            # Intelligent targeting and forwarding results
                            # Check if the ability is labeled an AoE, Heal, or Buff
                            is_aoe = ability_data.get("is_aoe", False)
                            is_heal = ability_data.get("is_heal", False)
                            is_buff = ability_data.get("is_buff", False)
                            
                            if is_aoe:
                                # For AoE, pass live_enemies or None (doesn't matter) and bypass the targeting prompt
                                return ability_data["func"](live_enemies)
                            elif is_heal:
                                return ability_data["func"](self)
                            elif is_buff:
                                return ability_data["func"](self)
                            else:
                                # For single target, run the targeting menu prompt normally
                                target = self._select_target(live_enemies)
                                # Pass the target AND return the result so Combat can see if it's "single" or "aoe"
                                return ability_data["func"](target)
                        else:
                            print(f"Not enough mana! You need {ability_data['cost']}.")
                            continue

                #Option 3: Use potions
                elif action_choice == 3:
                    # Filter items to show only things we actually have in stock
                    available_items = [item for item in self.inventory if item["qty"] > 0]
                    if not available_items:
                        print("Your inventory is empty!")
                        continue
                        
                    print("\n--- Choose an item ---")
                    for idx, item in enumerate(available_items, start=1):
                        print(f"[{idx}] {item['name']} x{item['qty']} (Restores {item['value']} {item['type'].upper()})")
                    print(f"[{len(available_items) + 1}] Back")
                    
                    sub_choice = int(input(f"Select (1-{len(available_items) + 1}): "))
                    if sub_choice == len(available_items) + 1:
                        continue # Go back to main loop
                        
                    if 1 <= sub_choice <= len(available_items):
                        chosen_item = available_items[sub_choice - 1]
                        chosen_item["qty"] -= 1 # Deduct quantity

                        #HP potion logic
                        if chosen_item["type"] == "hp":
                            if self.hp >= self.max_hp:
                                print(f"Your HP is already full!")
                                continue # Send back to item menu without consuming potion
                
                            old_hp = self.hp
                            self.hp = min(self.max_hp, self.hp + chosen_item["value"])
                            actual_healed = self.hp - old_hp
            
                            chosen_item["qty"] -= 1 # Only consume if successfully used
                            print(f"\n{self.name} used a {chosen_item['name']}! Restored {actual_healed} HP (HP: {self.hp}/{self.max_hp}).")
                            return "continue"

                        #Mana potion logic
                        elif chosen_item["type"] == "mana":
                            if self.mana >= self.max_mana:
                                print(f"Your Mana is already full!")
                                continue 
                
                            old_mana = self.mana
                            self.mana = min(self.max_mana, self.mana + chosen_item["value"])
                            actual_restored = self.mana - old_mana
            
                            chosen_item["qty"] -= 1 
                            print(f"\n{self.name} used a {chosen_item['name']}! Restored {actual_restored} Mana (Mana: {self.mana}/{self.max_mana}).")
                            return "continue"

                # Option 4: Flee
                elif action_choice == 4:
                    print(f"{self.name} attempts to flee from battle!")
                    return "flee"
                    
                print("Invalid choice. Try again.")
            except ValueError:
                print("Please enter a valid number.")

    def _select_target(self, live_enemies):
        # Helper method to isolate target selection parsing
        print("\nSelect a target:")
        for idx, enemy in enumerate(live_enemies, start=1):
            print(f"[{idx}] {enemy.name} (HP: {enemy.hp})")

        while True:
            try:
                target_choice = int(input(f"Select Target (1-{len(live_enemies)}): "))
                if 1 <= target_choice <= len(live_enemies):
                    return live_enemies[target_choice - 1]
                print("Invalid target number. Try again.")
            except ValueError:
                print("Please enter a valid number.")

