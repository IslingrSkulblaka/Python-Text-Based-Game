                        if qte_input.strip().lower() == "xy":
                            # Check if they did it in under 1.0 second
                            if elapsed_time <= 1.0:
                                parry_success = 2  # Perfect Parry
                            else:
                                parry_success = 1  # Normal Parry
                        else:
                            print(f"\nWrong buttons! You typed '{qte_input}'.")
        
                    except TimeoutOccurred:
                        print("\nParry failed.")
                        time.sleep(1)

                    time.sleep(1)

                    # Apply damage and reflection based on QTE success tier
                    if parry_success == 2:
                        # If parrired within 1 second, 0 damage
                        print(f"\nPERFECT PARRY! {self.player.name} perfectly deflected the blow and took 0 damage! ({elapsed_time:.2f}s)")
                        time.sleep(1)
    
                    elif parry_success == 1:
                        # If parried within 2 seconds, half damage
