        super().__init__(name, hp, attack, mana, crit_chance, crit_damage)
        self.max_hp = hp
        self.phase_two_triggered = False
        self.ultimate_cooldown = 0  # Number of turns before it can use its big move again

    def take_turn(self, player):
        # Determines the boss's actions dynamically based on its health or cooldowns.        
        # Phase 2 Transformation Logic
        if self.hp <= (self.max_hp * 0.4) and not self.phase_two_triggered:
            self.phase_two_triggered = True
            self.attack = int(self.attack * 1.5)  # Enrage: Increases attack power
            print(f"\n{self.name} becomes enraged! Their attack power increases drastically!")
            time.sleep(2)

        # Lower cooldowns if any are active
        if self.ultimate_cooldown > 0:
            self.ultimate_cooldown -= 1

        # AI Decision Making Matrix
        # Use an ultimate ability if cooldown is ready and condition met
        if self.phase_two_triggered and self.ultimate_cooldown == 0:
            self.ultimate_cooldown = 3  # 3 turn cooldown
            return self.use_ultimate(player)
            
        # Default: Normal Attack
        return self.use_club_swing()

