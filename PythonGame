class AudioManager:
    def __init__(self):
        # Initialize the pygame mixer
        mixer.init(frequency=44100)
        # Track what is currently playing to prevent restarting the same song
        self.current_track = None
        
        # Define paths to music files
        self.tracks = {
            "unknown_voice": "audio/unknown.wav"
        }

    def play_event_music(self, track_key):
        """Switches music based on game events (like creepy text appearing)."""
        if track_key not in self.tracks:
            print(f"[Audio Error] Track key '{track_key}' not found in tracks dictionary.")
            return
            
        # If the requested song is already playing, do nothing
        if self.current_track == track_key:
            return

        # Check if the file actually exists on the computer before playing
        if not os.path.exists(self.tracks[track_key]):
            print(f"[Audio Error] Missing file for {track_key} at {self.tracks[track_key]}")
            return

        try:
            # Fade out the current song over 1000 milliseconds (1 second)
            mixer.music.fadeout(2000)
            
            # Load and play the new track
            mixer.music.load(self.tracks[track_key])
            # loops=-1 means the track will loop infinitely until stopped
            mixer.music.play(loops=-1, fade_ms=2000) 
            
            self.current_track = track_key
        except Exception as e:
            print(f"[Audio Error] Could not play music: {e}")

    def stop_music(self, fade_ms=1500):
        # Smoothly fades out and stops whatever music track is currently playing.
        try:
            mixer.music.fadeout(fade_ms)
            self.current_track = None # Reset tracker so the same track can be re-triggered later
        except Exception as e:
            print(f"[Audio Error] Could not stop music: {e}")

