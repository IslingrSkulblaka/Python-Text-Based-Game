        # Catalog of items available to buy, with their stats and gold costs
        self.catalog = {
            1: {"name": "Healing Potion", "type": "hp", "value": 30, "cost": 15},
            2: {"name": "Mana Potion", "type": "mana", "value": 20, "cost": 10},
        }

    def enter_shop(self, player):
        print(f"\nWelcome to the Item Shop, {player.name}!")
        
        while True:
            print(f"\nYour Gold: {player.gold}")
            print("--- Items for Sale ---")
            
            # Display items dynamically from catalog
            for idx, item in self.catalog.items():
                print(f"[{idx}] {item['name']} - Cost: {item['cost']} Gold (Restores {item['value']} {item['type'].upper()})")
            
            exit_idx = len(self.catalog) + 1
            print(f"[{exit_idx}] Exit Shop")

            try:
                choice = int(input(f"What would you like to buy? (1-{exit_idx}): "))
                
                if choice == exit_idx:
                    break
                
                if choice in self.catalog:
                    selected_item = self.catalog[choice]
                    
                    # Check if the player has enough gold
                    if player.gold >= selected_item["cost"]:
                        player.gold -= selected_item["cost"]
                        
                        # Add to player's inventory stack or create a new entry
                        item_found = False
                        for inv_item in player.inventory:
                            if inv_item["name"] == selected_item["name"]:
                                inv_item["qty"] += 1
                                item_found = True
                                break
                        
                        # If the player didn't already own this item type, add it fresh
                        if not item_found:
                            player.inventory.append({
                                "name": selected_item["name"],
                                "type": selected_item["type"],
                                "value": selected_item["value"],
                                "qty": 1
                            })
                            
                        print(f"You purchased a {selected_item['name']} for {selected_item['cost']} gold!")
                    else:
                        print("You don't have enough gold for that item!")
                else:
                    print("Invalid option. Please choose from the catalog.")
                    
            except ValueError:
                print("Please enter a valid menu number.")


