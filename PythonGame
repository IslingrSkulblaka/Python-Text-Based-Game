            else:
                if current.hp > 0:
                    time.sleep(1)
                    print(f"\n{current.name}'s turn!")
                    time.sleep(1)
                    if isinstance(current, Boss):
                        print()
                    else:
                        print(f"{current.name} swings their sword at {self.player.name} for {current.attack} damage!")
                        time.sleep(1)

                    # QTE Parry Logic Implementation
                    parry_success = 0 
                    reflected_damage = 0

                    try:
