                        current.hp = min(current.max_hp, current.hp + heal_amount)
                    else:
                        current.hp += heal_amount
                    
                    print(f"{current.name} heals for {heal_amount} HP! (HP: {current.hp})")
                    time.sleep(1)

                # Universal buff implementation
                elif isinstance(result, tuple) and result[0] == "buff":
